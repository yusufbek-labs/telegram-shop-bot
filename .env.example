# Copy to .env and fill in. Never commit the real .env.

# Token from @BotFather (looks like 123456789:AA...)
BOT_TOKEN=

# Comma-separated Telegram user ids of the shop admins (ask @userinfobot for yours)
ADMIN_IDS=

# SQLite file location (relative to the project folder, or an absolute path)
DB_PATH=data/shop.db

# Shop display name and currency symbol
SHOP_NAME=Maple & Pine Goods
CURRENCY_SYMBOL=$

# Timezone used for "today" in /stats (IANA name, e.g. Europe/Berlin)
TIMEZONE=UTC

LOG_LEVEL=INFO

# Broadcast speed in messages per second (max 30, Telegram's global limit)
BROADCAST_RATE=20
