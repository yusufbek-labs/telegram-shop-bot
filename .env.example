# Copy to .env and fill in. Never commit the real .env.

# Token from @BotFather (looks like 123456789:AA...)
BOT_TOKEN=

# Comma-separated Telegram user ids of the shop admins (ask @userinfobot for yours)
ADMIN_IDS=

# SQLite file location (relative to the project folder, or an absolute path)
DB_PATH=data/shop.db

# Shop display name and currency symbol
SHOP_NAME=Maple & Pine Goods
CURRENCY_SYMBOL=$

# Timezone used for "today" in /stats (IANA name, e.g. Europe/Berlin)
TIMEZONE=UTC

LOG_LEVEL=INFO

# Broadcast speed in messages per second (max 30, Telegram's global limit)
BROADCAST_RATE=20

# Bank details shown to customers who choose "Bank transfer" (write a line break as \n).
# They then upload a receipt (photo or PDF). Leave empty to hide the bank transfer option.
PAYMENT_DETAILS=

# Google Sheets (optional, see "Google Sheets" in the README). Both must be set to turn it on.
# The id is the long part of the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Path to the service account JSON key; share the sheet with that account's email as Editor
GOOGLE_SERVICE_ACCOUNT_FILE=
# How often the bot reads the Menu and Orders tabs (seconds, at least 10)
SHEETS_SYNC_SECONDS=60
# Set to false to keep only the Orders log and not read the Menu tab
SHEETS_MENU_SYNC=true

# Public demo (optional): lets visitors try the bot. See "Public demo mode" in the README.
DEMO_MODE=false
# Test orders one visitor may place per day (the shop owner is not limited)
DEMO_MAX_ORDERS_PER_DAY=5
# Seconds until a visitor's new order moves to the next status by itself (0 = never)
DEMO_STATUS_SECONDS=60
